<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LanguageCoast" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Avoid a white flash before Compose draws the first frame. MainActivity changes it with the theme. -->
        <item name="android:windowBackground">@color/ocean_ground</item>
    </style>

    <!--
        Shown while the app starts; MainActivity switches to Theme.LanguageCoast via installSplashScreen().
        It is the dark coast, which is the theme the app starts in. The system draws the splash before the
        app runs, so for the other themes MainActivity tells it (Android 12 and later) which of the two
        variants below to use from the next start on. Their names are stored by the system: don't rename them.
    -->
    <style name="Theme.LanguageCoast.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ocean_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.LanguageCoast</item>
    </style>

    <!-- The splash for the light theme: daylight ground, with the mark on its dark disc as on the launcher icon. -->
    <style name="Theme.LanguageCoast.Starting.Light" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/daylight_ground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ocean_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.LanguageCoast</item>
    </style>

    <!-- The splash for the theme that follows the phone: light by day, dark at night (see values-night). -->
    <style name="Theme.LanguageCoast.Starting.System" parent="Theme.LanguageCoast.Starting.Light">
        <item name="windowSplashScreenBackground">@color/system_ground</item>
    </style>
</resources>
