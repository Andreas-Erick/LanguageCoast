<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for API 30 and below.
    The DataStore file holds the user's Gemini and OpenRouter API keys; exclude it
    so keys are never backed up to or restored from Google Drive automatically.
    See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
</full-backup-content>
