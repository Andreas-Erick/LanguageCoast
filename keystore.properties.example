# Optional local release signing configuration for Android builds.
# Copy this file to `keystore.properties` (git-ignored) to sign release APKs/AABs locally.
# Without it, local release builds fall back to the debug keystore; CI injects these via GitHub Actions secrets.

# Path to the JKS/PKCS12 keystore file, relative to the repository root.
storeFile=release-keystore.jks

# Password protecting the keystore file.
storePassword=change-me

# Alias of the signing key inside the keystore.
keyAlias=release

# Password protecting the signing key.
keyPassword=change-me
